# ── Avinode Web App (the embeddable search widget) ──────────────────────
# Avinode renders the whole search experience and captures the lead. Get the
# embed snippet from Avinode: Company -> Apps -> your web app -> Embed, and put
# its <script src="..."> URL here. When this is set it replaces the local search
# form and the Marketplace API path below.
#
# This is a public, client-side credential by design — unlike the API tokens.
NEXT_PUBLIC_AVINODE_WEBAPP_SRC=

# Avinode Marketplace API (sandbox)
# Request credentials from Avinode; the sandbox tenant is safe to experiment against.
AVINODE_API_BASE_URL=https://sandbox.avinode.com/api

# Identifies the integration; sent as X-Avinode-ApiToken.
AVINODE_API_TOKEN=your-avinode-api-token

# Identifies the Avinode user; sent as Authorization: Bearer.
AVINODE_AUTH_TOKEN=your-avinode-bearer-token

# Sent as X-Avinode-ApiVersion. Required on every request.
AVINODE_API_VERSION=v1

# Your application's name and version; sent as X-Avinode-Product.
AVINODE_PRODUCT=exjet-charter-landing/1.0

# Set to 1 to log the outgoing search body and the raw response to the server
# console. Tokens are never logged. Leave unset in production.
AVINODE_DEBUG=
