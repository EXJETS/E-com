# Avinode Marketplace API (sandbox)
# Request credentials from Avinode; the sandbox tenant is safe to experiment against.
AVINODE_API_BASE_URL=https://sandbox.avinode.com/api
AVINODE_API_TOKEN=your-avinode-api-token
AVINODE_AUTH_TOKEN=your-avinode-bearer-token
# Free-form identifier for this integration, sent as X-Avinode-Product.
AVINODE_PRODUCT=exjet-charter-landing
